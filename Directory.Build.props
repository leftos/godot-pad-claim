<Project>
  <!-- TargetFramework is deliberately absent: Godot rewrites one set here (godot#103545), so every csproj names
       its own net10.0. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <!-- A Godot export build is a release build with trimming, whatever the configuration is called. -->
    <Optimize Condition="'$(Configuration)' == 'ExportRelease'">true</Optimize>
  </PropertyGroup>

  <!-- Code-quality (CA) analyzers, taken from the first commit. -->
  <PropertyGroup>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- CA1502's threshold is read from this file only; the .editorconfig key is not read by the analyzer. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
  </ItemGroup>
</Project>
